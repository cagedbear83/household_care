DATABASE_URL="postgresql://postgres:postgres@localhost:5432/household_care?schema=public"
JWT_SECRET="replace-with-a-long-random-value"
JWT_EXPIRES_IN="12h"
PORT=4000

# Household configuration (used by the seed script; later this becomes admin-editable setup data)
APARTMENT_LAT="0"
APARTMENT_LNG="0"
GEOFENCE_RADIUS_METERS="60.96"
WEEKLY_HOUR_CAP="36"
HOUSEHOLD_TIMEZONE="America/Chicago"

# --- Family invitations (email / text message) -------------------------------
# Where invitation links point. Must be reachable by the person opening the
# message: your deployed web address in production, or your computer's LAN
# address (e.g. http://192.168.1.50:8081) to open a link from a phone in testing.
APP_BASE_URL="http://localhost:8081"

# With NO providers below configured (and NODE_ENV not "production"), messages are
# NOT sent: they are printed in this server's console and the invite screen shows the
# link, so the whole signup can be tried without any account. Set to "false" to turn that off.
ENABLE_DEV_OUTBOX="true"

# Email via SMTP (any provider that gives you an SMTP login):
# SMTP_URL="smtps://username:password@smtp.example.com:465"
# EMAIL_FROM="Household Care <no-reply@your-domain.example>"

# Text messages via Twilio:
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM="+15551234567"

# A food request nobody answers stays put; the administrator is alerted after this many minutes.
# FOOD_RESPONSE_MINUTES="30"

# This many tasks marked done within one minute raises an alert worded "may need a look" for administrators.
# COMPLETION_BURST_THRESHOLD="15"
